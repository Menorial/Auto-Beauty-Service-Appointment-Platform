# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=auto_beauty_db
DB_USERNAME=root
DB_PASSWORD=root123

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT配置
JWT_SECRET=auto-beauty-jwt-secret-key-2024
JWT_EXPIRATION=86400000

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10MB

# 邮件配置
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=your-email@qq.com

# 短信配置
SMS_ACCESS_KEY=your-sms-access-key
SMS_SECRET_KEY=your-sms-secret-key
SMS_SIGN_NAME=汽车美容平台
SMS_TEMPLATE_CODE=SMS_123456789

# 支付配置
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=your-alipay-private-key
ALIPAY_PUBLIC_KEY=your-alipay-public-key
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

WECHAT_APP_ID=your-wechat-app-id
WECHAT_MCH_ID=your-wechat-mch-id
WECHAT_API_KEY=your-wechat-api-key

# 应用配置
APP_NAME=汽车美容服务预约平台
APP_VERSION=1.0.0
APP_ENV=production
APP_DEBUG=false

# 服务器配置
SERVER_PORT=8081
SERVER_CONTEXT_PATH=/

# 日志配置
LOG_LEVEL=INFO
LOG_PATH=./logs
